{
  "name": "high-ai-council-chamber",
  "private": true,
  "version": "3.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "mcp": "node mcp-server.mjs",
    "search:dev": "tsx search-server/server.ts",
    "search:start": "tsx search-server/server.ts",
    "searxng:up": "docker compose -f ./searxng/docker-compose.yml up -d",
    "searxng:down": "docker compose -f ./searxng/docker-compose.yml down",
    "stack:start": "powershell -ExecutionPolicy Bypass -File ./start-search-stack.ps1",
    "stack:stop": "powershell -ExecutionPolicy Bypass -File ./stop-search-stack.ps1",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^1.20.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-is": "^19.2.4",
    "recharts": "^3.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.20.6",
    "typescript": "~5.8.2",
    "vite": "5"
  }
}
